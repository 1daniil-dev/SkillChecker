<Window x:Class="SkillChecker.Teacher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkillChecker — Панель преподавателя" Height="720" Width="1120"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C7D2FE"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavAccent" Grid.Column="0" Width="4" CornerRadius="2" Background="Transparent" Margin="0,0,10,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="NavAccent" Property="Background" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TestItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,9"/>
        </Style>

        <Style x:Key="ResultRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder" Background="Transparent" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="16,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="22,26,20,18">
                    <TextBlock Text="SkillChecker" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Панель преподавателя" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="#E2E8F0" Margin="14,0"/>

                <ListBox Grid.Row="2" x:Name="NavList" Margin="0,10,0,0"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="Обзор" Tag="overview"/>
                    <ListBoxItem Content="Тесты" Tag="tests"/>
                    <ListBoxItem Content="Результаты" Tag="results"/>
                </ListBox>

                <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="8" Margin="14,10,14,16" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                            <Setter Property="Fill" Value="#22C55E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ServerStatusText}" FontSize="12" Foreground="#334155" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid x:Name="OverviewPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Обзор" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Состояние сервера и подключение студентов" Style="{StaticResource SectionSubtitle}"/>
                </StackPanel>

                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServerStatusText}" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Студенты подключаются по адресу:" FontSize="13" Foreground="#64748B" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP-адрес:" FontSize="14" Foreground="#64748B" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IpAddressText}" FontSize="15" FontFamily="Consolas" Foreground="#0F172A" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Порт:" FontSize="14" Foreground="#64748B" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PortText}" FontSize="15" FontFamily="Consolas" Foreground="#0F172A"/>

                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="{Binding CopyButtonText}"
                                    Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding CopyAddressCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Top">
                    <Button Content="Открыть панель преподавателя" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPanelCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Закрытие окна остановит сервер" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </Grid>

            <Grid x:Name="TestsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Тесты" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Создание, редактирование и запуск тестов" Style="{StaticResource SectionSubtitle}"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                    <Button Content="Создать" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Command="{Binding CreateTestCommand}"/>
                    <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding EditTestCommand}"/>
                    <Button Content="Настроить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding SettingsTestCommand}"/>
                    <Button Content="Предпросмотр" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding PreviewTestCommand}"/>
                    <Button Content="Дублировать" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding DuplicateTestCommand}"/>
                    <Button Content="Удалить" Style="{StaticResource DangerButton}" Margin="0,0,8,8" Command="{Binding DeleteTestCommand}"/>
                    <Button Content="Импорт JSON" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding ImportTestCommand}"/>
                    <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Command="{Binding RefreshTestsCommand}"/>
                    <TextBlock Text="{Binding TestsInfoText}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,8"/>
                </WrapPanel>

                <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12">
                    <Grid>
                        <ListView ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}"
                                  ItemContainerStyle="{StaticResource TestItemStyle}"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                <TextBlock Text="{Binding DetailsText}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DetailsText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="10" Padding="9,3" Margin="0,0,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusLevel}" Value="1">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusLevel}" Value="2">
                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusLevel}" Value="1">
                                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusLevel}" Value="2">
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding QuestionCountText}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="Нет тестов — нажмите «Создать» или «Импорт JSON»" FontSize="14" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tests.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ResultsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Результаты" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Сдачи студентов в реальном времени" Style="{StaticResource SectionSubtitle}"/>
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                    <Border Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Сдало" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalValue}" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Средний балл" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding AverageValue}" FontSize="24" FontWeight="Bold" Foreground="#4F46E5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Лучший" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding BestValue}" FontSize="24" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="Худший" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding WorstValue}" FontSize="24" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Экспорт в Excel" Style="{StaticResource PrimaryButton}" Command="{Binding ExportResultsCommand}"/>
                        <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RefreshResultsCommand}"/>
                        <Button Content="Очистить" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Command="{Binding ClearResultsCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Поиск:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="8,6" FontSize="13" VerticalContentAlignment="Center"/>
                        <Button Content="{Binding DateSortLabel}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding SortByDateCommand}"/>
                        <Button Content="{Binding ScoreSortLabel}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding SortByScoreCommand}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="12,12,0,0" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="16,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16*"/>
                                    <ColumnDefinition Width="9*"/>
                                    <ColumnDefinition Width="14*"/>
                                    <ColumnDefinition Width="8*"/>
                                    <ColumnDefinition Width="8*"/>
                                    <ColumnDefinition Width="6*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ФИО" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="Группа" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="Тест" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="3" Text="Время" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="4" Text="Правильно" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="5" Text="Балл" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <ListView ItemsSource="{Binding ResultsView}" SelectedItem="{Binding SelectedResult}" BorderThickness="0" Background="Transparent"
                                      AlternationCount="2"
                                      ItemContainerStyle="{StaticResource ResultRowStyle}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16*"/>
                                                <ColumnDefinition Width="9*"/>
                                                <ColumnDefinition Width="14*"/>
                                                <ColumnDefinition Width="8*"/>
                                                <ColumnDefinition Width="8*"/>
                                                <ColumnDefinition Width="6*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StudentName}" FontSize="13" Foreground="#1E293B" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Group}" FontSize="13" Foreground="#334155" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TestName}" FontSize="13" Foreground="#334155" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DateText}" FontSize="13" Foreground="#64748B" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding CorrectText}" FontSize="13" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding ScoreText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ScoreLevel}" Value="1">
                                                                <Setter Property="Foreground" Value="#F57C00"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ScoreLevel}" Value="2">
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="{Binding EmptyText}" FontSize="14" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EmptyText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="16" Height="230" Margin="0,12,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedResult}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding SelectedResultTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <Button Content="Удалить результат" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Command="{Binding DeleteResultCommand}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding SelectedAnswers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✗"/>
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                                    <Setter Property="Text" Value="✓"/>
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding YourAnswerText}" FontSize="12" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding CorrectAnswerText}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
